{
  "name": "social-media-v2-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#topology": "topojson-client"
  },
  "scripts": {
    "dev": "../scripts/dev/start_local.sh",
    "dev:frontend": "vite",
    "dev:local": "../scripts/dev/start_local.sh",
    "generate:api": "openapi-typescript ../docs/contracts/social-media-v2-openapi.json -o src/api/openapi.generated.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "d3-geo": "^3.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "@redocly/openapi-core": {
      ".": "1.34.18",
      "js-yaml": "4.3.1"
    },
    "brace-expansion": "2.1.4",
    "nanoid": "3.3.17",
    "postcss": "8.5.26"
  }
}
