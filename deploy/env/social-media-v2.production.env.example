# Copy to /etc/social-media-v2/production.env and inject every secret outside Git.
APP_ENV=production
APP_NAME=social_media_v2
SOCIAL_RUNTIME_MODE=standalone_ready
SOCIAL_WRITES_ENABLED=false
SOCIAL_DB_URL=postgresql+psycopg://social_media_v2:CHANGE_ME@127.0.0.1/social_media_v2
SOCIAL_DB_REQUIRE_TLS=false
SOCIAL_VAULT_ENABLED=false
SOCIAL_SESSION_COOKIE_SECURE=true
SOCIAL_SSO_HS256_SECRET=
SOCIAL_MEDIA_STORAGE_ROOT=/var/lib/social-media-v2/media
SOCIAL_WORKER_SCHEDULE_ENABLED=false
SOCIAL_LOG_LEVEL=INFO

# V2-owned AI Summary provider. Keep disabled until the credential is injected
# into /etc/social-media-v2/production.env outside Git.
SOCIAL_AI_SUMMARY_ENABLED=false
SOCIAL_AI_OPENROUTER_API_KEY=
SOCIAL_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
SOCIAL_AI_OPENROUTER_MODELS=google/gemini-2.5-flash,google/gemini-2.5-flash-lite,google/gemini-3-flash-preview
SOCIAL_AI_SENTIMENT_MODEL=google/gemini-2.5-flash-lite
SOCIAL_AI_PROVIDER_TIMEOUT_SECONDS=45

SOCIAL_CREDENTIAL_ACTIVE_KEY_ID=
SOCIAL_CREDENTIAL_KEYRING_JSON=

SOCIAL_META_APP_ID=1133669534788144
SOCIAL_META_APP_SECRET=
SOCIAL_META_ACCOUNT_ENABLED=false
SOCIAL_META_ACCOUNT_OAUTH_MODE=disabled
SOCIAL_META_COLLECTION_ENABLED=false
SOCIAL_META_REDIRECT_URI=https://social.theaccumulate.com/api/social/meta/oauth/callback
SOCIAL_META_OAUTH_STATE_SECRET=
SOCIAL_META_ACTIVATION_GATE_ENABLED=false
SOCIAL_META_ACTIVATION_ENABLED_AT=
SOCIAL_META_ACTIVATION_EXPIRES_AT=

SOCIAL_TIKTOK_PROVIDER_PROFILE=tiktok_business_accounts_v1_3
SOCIAL_TIKTOK_BUSINESS_APP_ID=7657818426198474768
SOCIAL_TIKTOK_BUSINESS_APP_SECRET=
SOCIAL_TIKTOK_SECRET_ROTATED_AT=
SOCIAL_TIKTOK_ACCOUNT_ENABLED=false
SOCIAL_TIKTOK_ACCOUNT_OAUTH_MODE=disabled
SOCIAL_TIKTOK_COLLECTION_ENABLED=false
SOCIAL_TIKTOK_ADVERTISER_ENABLED=false
SOCIAL_TIKTOK_ACCOUNT_COMMENT_LIST_URL=https://business-api.tiktok.com/open_api/v1.3/business/comment/list/
