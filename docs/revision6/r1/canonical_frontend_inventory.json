    {
      "paths": ["/settings/audit"],
      "priority": 4,
      "auth": "required",
      "local_role_gate": ["super_admin", "developer", "owner"],
      "component": "AuditPage",
      "fallback_when_denied": "normal route fallback"
    },
    {
      "paths": ["/facebook", "/instagram", "/tiktok"],
      "priority": 5,
      "auth": "required",
      "component": "StandalonePlatformDashboardPage > SocialAppShell + PlatformDashboardPage",
      "deep_link": true
    },
    {
      "paths": ["*"],
      "priority": 6,
      "auth": "required",
      "demo_mode": true,
      "component": "StandalonePlatformDashboardPage",
      "platform": "facebook"
    },
    {
      "paths": ["/", "/settings", "unknown authenticated path"],
      "priority": 7,
      "auth": "required",
      "demo_mode": false,
      "component": "SettingsPage"
    }
