    {
      "paths": ["*"],
      "priority": 3,
      "auth": "missing_token",
      "component": "EntryGatePage",
      "visible_text": ["Accumulate", "Launch Social Media from Accumulate", "Open in Accumulate"],
      "external_target": "https://app.theaccumulate.com/apps/social-media"
