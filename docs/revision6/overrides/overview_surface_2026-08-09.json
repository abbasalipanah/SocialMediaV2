{
  "decision_id": "overview-surface-2026-08-09",
  "date": "2026-08-09",
  "status": "binding",
  "scope": "social_media_v2_overview_main_content",
  "overrides": [
    "SOCIAL_MEDIA_V2_MASTER_PLAN.md §0.0 canonical-source no-Overview restriction",
    "SOCIAL_MEDIA_V2_MASTER_PLAN.md §6.2 no-new-visible-navigation restriction",
    "SOCIAL_MEDIA_V2_MASTER_PLAN.md §6.5 root Settings fallback",
    "Earlier R14 seven-section Accumulate dashboard layout"
  ],
  "routes": {
    "home": "/",
    "overview": "/overview",
    "same_workspace": true
  },
  "navigation": {
    "visible_overview_entry": "Home only",
    "overview_deep_link_visible_in_sidebar": false,
    "duplicate_home_overview_entries_allowed": false,
    "sidebar_topbar_footer_redesign_allowed": false
  },
  "readonly_references": [
    "/home/api/colab_scripts/Accumulate/frontend/components/accumulate/SocialMediaDashboard.tsx",
    "/home/api/colab_scripts/Accumulate/backend/app/api/routes/ai.py",
    "/home/api/colab_scripts/SocialMedia/backend/app/services/ai_insight_service.py"
  ],
  "kpis": [
    "Overall Organic Health",
    "Total Audience",
    "Total Reach",
    "Total Impressions",
    "Total Interactions",
    "Avg. Engagement"
  ],
  "sections": [
    "What Changed?",
    "Channel Health",
    "Performance Trend",
    "Content Snapshot",
    "Top Performing Content",
    "Alerts & Opportunities",
    "Platform Summary"
  ],
  "platforms": ["instagram", "facebook", "tiktok"],
  "display_contract": {
    "total_impressions": "normalized views display alias",
    "avg_engagement": "interactions / reach",
    "engagement_delta": "current engagement rate minus previous engagement rate, in percentage points",
    "health": "available audience, reach, interaction and engagement comparison signals: >=75% non-declining Healthy, >=50% Stable, otherwise Needs Attention; fewer than two signals Limited Data",
    "what_changed": "largest absolute comparable period delta per platform",
    "channel_health": "Attention when audience or interaction delta <= -5%; Growing when either >= +2% without that decline; otherwise Stable",
    "missing_value_policy": "do_not_render_as_zero",
    "trend_period_policy": "full selected backend series",
    "content_type_policy": "top three content types plus an exact aggregated Other row when more than four types exist"
  },
  "ai_insights": {
    "source": "stored read-only /api/insights response",
    "alerts_source": "stored action_recommendations only",
    "stored_period_visible": true,
    "generation_or_mutation_on_open": false,
    "accessible_dialog_required": true,
    "local_snapshot_allowed_fields": ["strategic_summary", "action_recommendations"],
    "excluded_fields": ["raw_metrics_snapshot", "llm/provider configuration", "connector_analysis", "anomalies", "platform_evaluations"]
  },
  "runtime_boundaries": {
    "protected_projects_read_only": true,
    "production_provider_egress": false,
    "production_database_write": false,
    "worker_or_schedule_activation": false
  },
  "change_control": "Requires a new explicit user decision."
}
