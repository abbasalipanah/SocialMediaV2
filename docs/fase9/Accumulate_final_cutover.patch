+def social_media_watermarks(db: Session) -> tuple[int, int]:
+    emitted = db.scalar(
+        select(func.coalesce(func.max(ProvisioningEvent.id), 0))
+        .where(ProvisioningEvent.app_id == "social_media")
+    )
+    applied = db.scalar(
+        select(func.coalesce(func.max(ProvisioningEvent.id), 0))
+        .where(ProvisioningEvent.app_id == "social_media")
+        .where(ProvisioningEvent.status == "dispatched")
+    )
+    return int(emitted or 0), int(applied or 0)

